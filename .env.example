CLOCKIFY_API_KEY=your_clockify_api_key_here

# Client → Project → Activity (see: python clockify-auto.py discover)
CLOCKIFY_WORKSPACE_NAME=Your Workspace Name
CLOCKIFY_CLIENT_NAME=Nexstar Media Inc
CLOCKIFY_PROJECT_NAME=NexStar
CLOCKIFY_ACTIVITY_NAME=Working Time

# PTO / holidays (Activity: PTO + tag Vacation/Holiday/Personal)
# Use separate client/project values if PTO is tracked outside the default client project.
CLOCKIFY_PTO_CLIENT_NAME=
CLOCKIFY_PTO_PROJECT_NAME=
CLOCKIFY_PTO_ACTIVITY_NAME=PTO
CLOCKIFY_PTO_ACTIVITY_TASK_ID=      # optional; use if task listing is restricted but you know the PTO taskId
CLOCKIFY_HOLIDAY_DESCRIPTION=Public holiday — Argentina

# Timezone and working hours
CLOCKIFY_TZ=America/Bogota
CLOCKIFY_START_TIME=08:00
CLOCKIFY_END_TIME=16:00
